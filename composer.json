{
    "name": "bastianschwabe/jobs",
    "type": "typo3-cms-extension",
    "description": "Job postings for TYPO3: filterable list, detail view and standards-compliant schema.org/JobPosting JSON-LD output for Google for Jobs.",
    "keywords": [
        "TYPO3 CMS",
        "jobs",
        "job posting",
        "career",
        "vacancy",
        "schema.org",
        "JobPosting",
        "structured data",
        "google for jobs"
    ],
    "homepage": "https://github.com/bastianschwabe/typo3-jobs",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Bastian Schwabe",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/bastianschwabe/typo3-jobs/issues",
        "source": "https://github.com/bastianschwabe/typo3-jobs"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "Build/TestSite",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "bastianschwabe/jobs-testsite": "@dev",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-dashboard": "^14.3",
        "typo3/cms-filelist": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/cms-lowlevel": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3",
        "typo3/cms-tstemplate": "^14.3",
        "typo3/coding-standards": "^0.8",
        "typo3/testing-framework": "^9.2"
    },
    "suggest": {
        "typo3/cms-dashboard": "Adds a dashboard widget with the most viewed and most applied-to jobs"
    },
    "autoload": {
        "psr-4": {
            "BastianSchwabe\\Jobs\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BastianSchwabe\\Jobs\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "Package": {
                "providesPackages": {}
            },
            "extension-key": "jobs",
            "version": "0.1.0",
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "ci": [
            "@lint:php",
            "@cs:check",
            "@analyse",
            "@test"
        ],
        "analyse": ".Build/bin/phpstan analyse --configuration=Build/phpstan.neon --memory-limit=1G",
        "cs:check": ".Build/bin/php-cs-fixer fix --config=Build/.php-cs-fixer.php --dry-run --diff",
        "cs:fix": ".Build/bin/php-cs-fixer fix --config=Build/.php-cs-fixer.php",
        "lint:php": "find Classes Configuration Tests -name '*.php' -print0 | xargs -0 -n1 -P4 php -l >/dev/null",
        "test": [
            "@test:unit",
            "@test:functional"
        ],
        "test:functional": "php -d memory_limit=-1 .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml",
        "test:unit": "php -d memory_limit=512M .Build/bin/phpunit -c Build/phpunit/UnitTests.xml"
    }
}
