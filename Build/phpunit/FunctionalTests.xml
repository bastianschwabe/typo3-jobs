<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.3/phpunit.xsd"
         backupGlobals="true"
         bootstrap="FunctionalTestsBootstrap.php"
         cacheDirectory="../../.phpunit.cache"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnRisky="true"
         failOnWarning="true"
         requireCoverageMetadata="false"
>
    <testsuites>
        <testsuite name="jobs functional tests">
            <directory>../../Tests/Functional/</directory>
        </testsuite>
    </testsuites>
    <!--
        SQLite by default, so the suite runs on the host without Docker.
        PHPUnit does not overwrite variables that already exist, so inside the
        DDEV container the exported MariaDB credentials win.
    -->
    <php>
        <env name="typo3DatabaseDriver" value="pdo_sqlite"/>
    </php>
    <source>
        <include>
            <directory>../../Classes/</directory>
        </include>
    </source>
</phpunit>
